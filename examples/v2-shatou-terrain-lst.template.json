{
  "version": 2,
  "status": "design-template-not-runnable-in-v1",
  "name": "Shatou Terrain + LST + Climate + Rhino",
  "nodes": [
    {"id": "boundary", "type": "boundary-input", "params": {"layer": "boundary"}},
    {"id": "dem", "type": "raster-input", "params": {"file": "深圳DEM.tif", "valueMode": "relative_intensity"}},
    {"id": "lst", "type": "raster-input", "params": {"file": "深圳LST.tif", "valueMode": "relative_intensity"}},
    {"id": "buildings", "type": "vector-input", "params": {"file": "沙头建筑新.shp", "heightField": "BLDG_HEIGH"}},
    {"id": "epw", "type": "epw-input", "params": {"file": "CHN_GD_Shenzhen.594930_TMYx.2004-2018.epw"}},
    {"id": "crs", "type": "local-metric-crs", "params": {"mode": "auto"}},
    {"id": "grid", "type": "raster-to-fishnet", "params": {"cellSizeMeters": 30, "statistic": "mean", "maxCells": 50000}},
    {"id": "ground", "type": "building-ground-mask", "params": {"method": "nearest_non_building_median", "maxRadiusCells": 3}},
    {"id": "surface", "type": "grid-to-surface-mesh", "params": {"vertexMethod": "mean_adjacent_cells", "verticalScale": 0.15}},
    {"id": "wire", "type": "grid-border-style", "params": {"visible": true, "color": "#6D7480", "width": 0.6, "opacity": 0.55}},
    {"id": "lst-grid", "type": "zonal-statistics", "params": {"statistic": "mean", "unit": "relative_intensity"}},
    {"id": "lst-style", "type": "continuous-color-ramp", "params": {"palette": "thermal", "showUnit": false}},
    {"id": "climate", "type": "epw-reader", "params": {"date": "07-15", "hour": 14}},
    {"id": "map", "type": "map-output", "params": {"separateBasemap": true}},
    {"id": "rhino", "type": "rhino-3dm-output", "params": {"units": "meters", "layers": "standard-v2"}}
  ],
  "edges": [
    {"source": "boundary", "target": "crs"},
    {"source": "dem", "target": "grid"},
    {"source": "crs", "target": "grid"},
    {"source": "buildings", "target": "ground"},
    {"source": "grid", "target": "ground"},
    {"source": "ground", "target": "surface"},
    {"source": "surface", "target": "wire"},
    {"source": "lst", "target": "lst-grid"},
    {"source": "grid", "target": "lst-grid"},
    {"source": "lst-grid", "target": "lst-style"},
    {"source": "epw", "target": "climate"},
    {"source": "surface", "target": "map"},
    {"source": "wire", "target": "map"},
    {"source": "lst-style", "target": "map"},
    {"source": "buildings", "target": "map"},
    {"source": "surface", "target": "rhino"},
    {"source": "wire", "target": "rhino"},
    {"source": "lst-style", "target": "rhino"},
    {"source": "buildings", "target": "rhino"}
  ]
}
